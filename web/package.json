{
  "name": "school-work-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Renders the repo's Markdown (with LaTeX) in a browser. Used to show derivations and formulas that the CLI cannot display.",
  "scripts": {
    "dev": "vite",
    "stop": "lsof -ti tcp:8010 | xargs kill 2>/dev/null || echo 'ingen server på port 8010'",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  }
}
